msgstr "Желтая"

msgid "gnihihi"
msgstr "хихихи"

msgid "Line 4, blurbblubb"
msgstr "Строка 4, брбрбрбрбр"

msgid "Oh nice, I added a fourth line!"
msgstr "О, здорово, я добавил четвёртую строку!"

msgid "blurbblubb"
msgstr "брбрбрбрбр"

msgid "You ate.*baguette"
msgstr "Вы съели.*багет"

msgid "You drank.*coffee"
msgstr "Вы выпили.*кофе"

msgid "You ate.*donut"
msgstr "Вы съели.*пончик"

msgid "10 coins"
msgstr "10 монет"

msgid "- 4 Apples"
msgstr "- 4 яблока"

msgid "- 500g Flour"
