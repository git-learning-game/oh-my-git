title = _(Restore a deleted file)
cards = checkout

[description]

_(Oops - you deleted the "essay" file, which you worked on all night!

Luckily, Git is here to help! You can use `git checkout` to restore the file!)

[setup]

echo "_(important)"  > essay
git add .
git commit -m "Initial commit"
echo "_(important content)" > essay
git commit -am "Improve essay"
rm essay

[win]

# _(Restore the essay to contain "important content")
test "$(cat essay)" = "_(important content)"
