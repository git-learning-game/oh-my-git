title = _(Make a commit \o/)
cards = add reset checkout commit

[description]

_(For practice, make a commit where all files contain an "x"!)

[setup]

echo a > a
echo x > b
echo x > c
git add .
git commit -m "Initial commit"
echo x > a
echo b > b
git add b
echo c > c

[win]

# _(File a contains "x" in the last main commit.)
test "$(git show main:a)" = x
# _(File b contains "x" in the last main commit.)
test "$(git show main:b)" = x
# _(File c contains "x" in the last main commit.)
test "$(git show main:c)" = x
